---
import '../styles/site.css';
import nastavitve from '../data/nastavitve.json';
import urnik from '../data/urnik.json';

// naslovnica: na naslovnici so povezave samo sidra (#urnik) in gumb odpre obrazec;
// na podstraneh vodijo nazaj na naslovnico, obrazec pa se odpre prek #prijava.
const { naslov = 'Gracie Barra Domžale', opis = 'Prototip prenove spletne strani Gracie Barra Domžale.', naslovnica = false } = Astro.props;
const { kontakt } = nastavitve;

const domov = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (p) => domov + String(p).replace(/^\//, '');
const sidro = (id) => (naslovnica ? '' : domov) + '#' + id;
const kanonicni = new URL(Astro.url.pathname, Astro.site ?? 'https://gbdomzale.si').href;
---

<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8">
<meta name="description" content={opis}>
<link rel="canonical" href={kanonicni}>
<meta property="og:title" content={naslov}>
<meta property="og:description" content={opis}>
<meta property="og:type" content="website">
<meta property="og:url" content={kanonicni}>
<meta property="og:image" content={new URL(asset("/video/hero-poster.jpg"), Astro.site ?? "https://gbdomzale.si").href}>
<meta property="og:locale" content="sl_SI">
<meta name="twitter:card" content="summary_large_image">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{naslov}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800;1,900&family=Barlow:wght@400;500;600;700&display=swap">
</head>
<body>

<slot name="pred-glavo" />

<header class="top">
  <div class="wrap">
    <a class="brand" href={naslovnica ? '#' : domov} aria-label="Gracie Barra Domžale — domov">
      <img src={asset('/img/logo.png')} alt="" width="48" height="49">
      <span>Gracie Barra<small>Domžale</small></span>
    </a>
    <nav class="nav" aria-label="Glavna navigacija">
      <a href={sidro('programi')}>Programi</a>
      <a href={sidro('urnik')}>Urnik</a>
      <a href={sidro('gb')}>O Gracie Barra</a>
      <a href={sidro('kontakt')}>Kontakt</a>
    </nav>
    {naslovnica
      ? <button class="btn sm" data-book>Brezplačna uvodna ura</button>
      : <a class="btn sm" href={domov + '#prijava'}>Brezplačna uvodna ura</a>}
  </div>
</header>

<slot />

<footer class="foot" id="kontakt">
  <div class="wrap">
    <div class="grid">
      <div>
        <a class="brand" href={naslovnica ? '#' : domov} aria-label="Gracie Barra Domžale"><img src={asset('/img/logo.png')} alt="" width="48" height="49"><span>Gracie Barra<small>Domžale</small></span></a>
        <p style="margin-top:16px;max-width:32ch">{kontakt.opis}</p>
      </div>
      <div>
        <h4>Kje smo</h4>
        <ul>
          <li>{kontakt.naslov_vrstica1}<br>{kontakt.naslov_vrstica2}</li>
          <li><a href={kontakt.zemljevid} target="_blank" rel="noopener">Odpri zemljevid →</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontakt</h4>
        <ul>
          <li><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></li>
          <li><a href={kontakt.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={kontakt.facebook} target="_blank" rel="noopener">Facebook</a></li>
        </ul>
      </div>
      <div>
        <h4>Šola</h4>
        <ul>
          <li><a href={sidro('programi')}>Programi</a></li>
          <li><a href={sidro('urnik')}>Urnik {urnik.sezona}</a></li>
          <li><a href={domov + 'cenik/'}>Cenik</a></li>
          <li><a href={domov + 'pogoji-poslovanja/'}>Pogoji poslovanja</a></li>
        </ul>
      </div>
    </div>
    <div class="legal"><span>© 2026 Gracie Barra Domžale</span><span>Jiu-Jitsu for Everyone®</span></div>
  </div>
</footer>

<div class="mcta">
  {naslovnica
    ? <button class="btn" data-book>Brezplačna uvodna ura <i class="arr">→</i></button>
    : <a class="btn" href={domov + '#prijava'}>Brezplačna uvodna ura <i class="arr">→</i></a>}
</div>

<slot name="po-nogi" />

</body>
</html>
